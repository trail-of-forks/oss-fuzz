TARGET=Fuzzer

#File
CLIENTEXE=FuzzClient
SERVEREXE=FuzzServer
SERVERREPLYEXE=FuzzServerReply
DATACONVEXE=FuzzDataConversion
CLIENTWRITEEXE=FuzzClientWrite
RAWREQUESTEXE=FuzzRawRequest
RTUFRAMEEXE=FuzzRtuFrame

#Compiler Flags
SET=cd ../ &&
INC=-I../src/
LIB=../src/libmodbus.la
EXTCFLAGS= -Wall -Wextra
LIBTOOL=libtool --mode=link --tag=CXX

all: $(TARGET)

#SETUP
INIT:
	$(SET) ./autogen.sh

CONF:
	$(SET) ./configure --disable-shared CC=$(CC) CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)"

MAKEALL:
	$(SET) make -j$(nproc)

CPFILE:
	cp ../tests/unit-test.h .

$(TARGET): INIT CONF MAKEALL CPFILE
	$(CC) $(EXTCFLAGS) $(CFLAGS) $(INC) -c $(CLIENTEXE).c
	$(LIBTOOL) $(CXX) $(LDFLAGS) $(CFLAGS) $(LIB) $(LIB_FUZZING_ENGINE) $(CLIENTEXE).o -o $(CLIENTEXE)

	$(CC) $(EXTCFLAGS) $(CFLAGS) $(INC) -c $(SERVEREXE).c
	$(LIBTOOL) $(CXX) $(LDFLAGS) $(CFLAGS) $(LIB) $(LIB_FUZZING_ENGINE) $(SERVEREXE).o -o $(SERVEREXE)

	$(CC) $(EXTCFLAGS) $(CFLAGS) $(INC) -c $(SERVERREPLYEXE).c
	$(LIBTOOL) $(CXX) $(LDFLAGS) $(CFLAGS) $(LIB) $(LIB_FUZZING_ENGINE) $(SERVERREPLYEXE).o -o $(SERVERREPLYEXE)

	$(CC) $(EXTCFLAGS) $(CFLAGS) $(INC) -c $(DATACONVEXE).c
	$(LIBTOOL) $(CXX) $(LDFLAGS) $(CFLAGS) $(LIB) $(LIB_FUZZING_ENGINE) $(DATACONVEXE).o -o $(DATACONVEXE)

	$(CC) $(EXTCFLAGS) $(CFLAGS) $(INC) -c $(CLIENTWRITEEXE).c
	$(LIBTOOL) $(CXX) $(LDFLAGS) $(CFLAGS) $(LIB) $(LIB_FUZZING_ENGINE) $(CLIENTWRITEEXE).o -o $(CLIENTWRITEEXE)

	$(CC) $(EXTCFLAGS) $(CFLAGS) $(INC) -c $(RAWREQUESTEXE).c
	$(LIBTOOL) $(CXX) $(LDFLAGS) $(CFLAGS) $(LIB) $(LIB_FUZZING_ENGINE) $(RAWREQUESTEXE).o -o $(RAWREQUESTEXE)

	$(CC) $(EXTCFLAGS) $(CFLAGS) $(INC) -c $(RTUFRAMEEXE).c
	$(LIBTOOL) $(CXX) $(LDFLAGS) $(CFLAGS) $(LIB) $(LIB_FUZZING_ENGINE) $(RTUFRAMEEXE).o -lutil -o $(RTUFRAMEEXE)

clean:
	rm -f $(CLIENTEXE) $(SERVEREXE) $(SERVERREPLYEXE) $(DATACONVEXE) $(CLIENTWRITEEXE) $(RAWREQUESTEXE) $(RTUFRAMEEXE) *.o

.PHONY: all clean
