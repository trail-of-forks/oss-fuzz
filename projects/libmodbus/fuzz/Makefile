TARGET=Fuzzer

#File
SERVEREXE=FuzzServer
CLIENTWRITEEXE=FuzzClientWrite
CLIENTREADEXE=FuzzClientRead
SERVERRTUEXE=FuzzServerRTU
CLIENTRTUEXE=FuzzClientRTU
DATACONVEXE=FuzzDataConversion

#Compiler Flags
SET=cd ../ &&
INC=-I../src/
LIB=../src/libmodbus.la
EXTCFLAGS= -Wall -Wextra
LIBTOOL=libtool --mode=link --tag=CXX

all: $(TARGET)

#SETUP
INIT:
	$(SET) ./autogen.sh

CONF:
	$(SET) ./configure --disable-shared CC=$(CC) CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)"

MAKEALL:
	$(SET) make -j$(nproc)

CPFILE:
	cp ../tests/unit-test.h .

$(TARGET): INIT CONF MAKEALL CPFILE
	$(CC) $(EXTCFLAGS) $(CFLAGS) $(INC) -c $(SERVEREXE).c
	$(LIBTOOL) $(CXX) $(LDFLAGS) $(CFLAGS) $(LIB) $(LIB_FUZZING_ENGINE) $(SERVEREXE).o -o $(SERVEREXE)

	$(CC) $(EXTCFLAGS) $(CFLAGS) $(INC) -c $(CLIENTWRITEEXE).c
	$(LIBTOOL) $(CXX) $(LDFLAGS) $(CFLAGS) $(LIB) $(LIB_FUZZING_ENGINE) $(CLIENTWRITEEXE).o -o $(CLIENTWRITEEXE)

	$(CC) $(EXTCFLAGS) $(CFLAGS) $(INC) -c $(SERVERRTUEXE).c
	$(LIBTOOL) $(CXX) $(LDFLAGS) $(CFLAGS) $(LIB) $(LIB_FUZZING_ENGINE) $(SERVERRTUEXE).o -o $(SERVERRTUEXE)

	$(CC) $(EXTCFLAGS) $(CFLAGS) $(INC) -c $(CLIENTREADEXE).c
	$(LIBTOOL) $(CXX) $(LDFLAGS) $(CFLAGS) $(LIB) $(LIB_FUZZING_ENGINE) $(CLIENTREADEXE).o -o $(CLIENTREADEXE)

	$(CC) $(EXTCFLAGS) $(CFLAGS) $(INC) -c $(CLIENTRTUEXE).c
	$(LIBTOOL) $(CXX) $(LDFLAGS) $(CFLAGS) $(LIB) $(LIB_FUZZING_ENGINE) $(CLIENTRTUEXE).o -o $(CLIENTRTUEXE)

	$(CC) $(EXTCFLAGS) $(CFLAGS) $(INC) -c $(DATACONVEXE).c
	$(LIBTOOL) $(CXX) $(LDFLAGS) $(CFLAGS) $(LIB) $(LIB_FUZZING_ENGINE) $(DATACONVEXE).o -o $(DATACONVEXE)

clean:
	rm -f $(SERVEREXE) $(CLIENTWRITEEXE) $(CLIENTREADEXE) $(SERVERRTUEXE) $(CLIENTRTUEXE) $(DATACONVEXE) *.o

.PHONY: all clean
